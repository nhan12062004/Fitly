# =========================================================================
# Fitly Workspace Gitignore
# =========================================================================

# 📦 Dependencies
node_modules/
*/node_modules/
yarn.lock
pnpm-lock.yaml

# 🏗️ Build & Output directories
dist/
*/dist/
build/
*/build/
Mobile/android/.gradle/
Mobile/android/.cxx/
out/
.next/
bin/
obj/

# 🔒 Environment Variables (CRITICAL: Do not commit secrets!)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*
!.env.example
*/.env
*/.env.*
!*/.env.example
Backend/src/env

# 🧪 Testing & Coverage
coverage/
.nyc_output
htmlcov/
*.lcov

# 📝 System Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 💻 IDEs, Editors & System files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ⚙️ TypeScript
*.tsbuildinfo
tsconfig.tsbuildinfo

# 🛠️ Development & Agent Specific Tools
.agent/
.claude/
.gemini/
metadata.json
artifacts/
scratch/

# 🗄️ Database & Temp Files
*.sql
!docs/*.sql
.supabase/
supabase/*
!supabase/migrations/
!supabase/migrations/*.sql
!supabase/config.toml
!supabase/tests/
!supabase/tests/*.sql
!supabase/tests/*.md
!supabase/seeds/
!supabase/seeds/*.sql
!supabase/BASELINE.md
!supabase/verify_rpc_execute_privileges.sql
!supabase/verify_security_hardening.sql
Backend/migrations/
docs/backups/
metadata.json

# 📂 Datasets & Scraping scripts
dataset_scripts/
exercises-dataset/
dataforseo.json

# Android build artifacts
*.apk
