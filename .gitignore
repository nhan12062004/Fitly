# =========================================================================
# TrendFit Workspace Gitignore
# =========================================================================

# 📦 Dependencies
node_modules/
*/node_modules/
package-lock.json
*/package-lock.json
yarn.lock
pnpm-lock.yaml

# 🏗️ Build & Output directories
dist/
*/dist/
build/
*/build/
out/
.next/
bin/
obj/

# 🔒 Environment Variables (CRITICAL: Do not commit secrets!)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*
!.env.example
*/.env
*/.env.*
!*/.env.example

# 🧪 Testing & Coverage
coverage/
.nyc_output
htmlcov/
*.lcov

# 📝 System Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 💻 IDEs, Editors & System files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ⚙️ TypeScript
*.tsbuildinfo
tsconfig.tsbuildinfo

# 🛠️ Development & Agent Specific Tools
.agent/
.claude/
.gemini/
metadata.json
artifacts/
scratch/

# 🗄️ Database & Temp Files
*.sql
!docs/*.sql
.supabase/
supabase/
Backend/migrations/
docs/backups/
metadata.json

# 📂 Datasets & Scraping scripts
dataset_scripts/
exercises-dataset/
dataforseo.json
