# Dependencies and Expo caches are restored by EAS Build.
node_modules/
.expo/
.expo-*/
dist/
web-build/

# Local native build caches must never be archived. They can contain locked files
# while Gradle is running and are regenerated by the remote builder.
android/.gradle/
android/build/
android/app/build/
android/.cxx/

# Local credentials and editor artefacts.
.env
.env.*
!.env.example
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
.kotlin/
.metro-health-check*
npm-debug.*
yarn-debug.*
yarn-error.*
*.tsbuildinfo
.DS_Store

# Store builds regenerate native projects from the reviewed Expo config/plugins.
android/
ios/
