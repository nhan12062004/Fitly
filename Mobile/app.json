{
  "expo": {
    "name": "Fitly",
    "slug": "fitly",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fitly",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#050505",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "io.github.nhan12062004.fitly",
      "supportsTablet": false
    },
    "android": {
      "package": "io.github.nhan12062004.fitly",
      "adaptiveIcon": {
        "backgroundColor": "#0B1310",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "edgeToEdgeEnabled": true
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B1310",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "Cho phép Fitly sử dụng micro để ghi âm tin nhắn cho AI Coach."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Cho phép Fitly dùng camera để chụp ảnh gửi cho AI Coach.",
          "photosPermission": "Cho phép Fitly truy cập ảnh để gửi cho AI Coach."
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "fitly-reminders",
          "enableBackgroundRemoteNotifications": true
        }
      ],
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2965c6fe-b108-41a0-b820-41022acb2e54"
      }
    },
    "owner": "nhan12062004"
  }
}
