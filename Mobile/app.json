{
  "expo": {
    "name": "Fitly",
    "slug": "fitly",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/fitly-icon.png",
    "scheme": "fitly",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#050505",
    "ios": {
      "icon": "./assets/images/fitly-icon.png",
      "bundleIdentifier": "io.github.nhan12062004.fitly",
      "supportsTablet": false,
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyTracking": false
      }
    },
    "android": {
      "package": "io.github.nhan12062004.fitly",
      "adaptiveIcon": {
        "backgroundColor": "#050505",
        "foregroundImage": "./assets/images/fitly-adaptive-foreground.png",
        "monochromeImage": "./assets/images/fitly-adaptive-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 1,
      "allowBackup": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/fitly-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#111111",
          "image": "./assets/images/fitly-splash.png",
          "imageWidth": 112
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Cho phép Fitly dùng camera để chụp ảnh đại diện.",
          "photosPermission": "Cho phép Fitly chọn ảnh đại diện từ thiết bị.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "fitly-reminders",
          "enableBackgroundRemoteNotifications": false
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "./plugins/with-store-config.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2965c6fe-b108-41a0-b820-41022acb2e54"
      }
    },
    "owner": "nhan12062004"
  }
}
