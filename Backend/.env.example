# Local server and browser origin
PORT=5001
FRONTEND_URL=http://localhost:3000

# Supabase server credentials
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=

# AI Coach
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

CRON_SECRET=

# Server-only RevenueCat v1 secret key and exact webhook Authorization value
REVENUECAT_SECRET_API_KEY=
REVENUECAT_WEBHOOK_AUTHORIZATION=
REVENUECAT_PLUS_ENTITLEMENT=fitly_plus
REVENUECAT_PRO_ENTITLEMENT=fitly_pro
# Enable only on the backend used for sandbox/TestFlight/review testing
REVENUECAT_ALLOW_SANDBOX=false

# Runtime / production hardening
NODE_ENV=development
ENABLE_JOBS=false
DATABASE_TIMEOUT_MS=12000
READY_TIMEOUT_MS=3000
SHUTDOWN_TIMEOUT_MS=10000
SENTRY_DSN=
# Production enforces MFA for admin routes by default. Enable TOTP in Auth.
REQUIRE_ADMIN_MFA=true
AI_ENABLED=true
AI_MAX_CONCURRENT=8
AI_DAILY_REQUEST_LIMIT=5000
AI_DAILY_PROVIDER_CALL_LIMIT=10000
AI_DAILY_TOKEN_LIMIT=10000000
# Search only receives allowlisted food labels; disabled by default.
MARKET_PRICE_SEARCH_ENABLED=false
