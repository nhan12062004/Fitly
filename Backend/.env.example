# Local server and browser origin
PORT=5001
FRONTEND_URL=http://localhost:3000

# Supabase server credentials
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=

# AI Coach
