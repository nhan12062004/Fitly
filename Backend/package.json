{
    "name": "backend",
    "version": "1.0.0",
    "description": "",
    "scripts": {
        "dev": "npx tsx watch src/server.ts",
        "start": "npx tsx src/server.ts",
        "build": "tsc --noEmit",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "db:migration:list": "npx supabase migration list --workdir ..",
        "db:migration:repair:normalize-rls": "npx supabase migration repair 20260602110000 --status applied --linked --workdir ..",
        "db:push": "npx supabase db push --linked --include-all --workdir .."
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "type": "commonjs",
    "engines": {
        "node": ">=22.22.0"
    },
    "dependencies": {
        "@sentry/node": "10.68.0",
        "@supabase/supabase-js": "2.110.9",
        "cors": "^2.8.6",
        "dotenv": "^17.4.1",
        "express": "^5.2.1",
        "express-rate-limit": "^8.5.2",
        "helmet": "^8.2.0",
        "node-cron": "^4.2.1",
        "node-telegram-bot-api": "1.2.0",
        "tsx": "^4.21.0",
        "zod": "4.3.6"
    },
    "devDependencies": {
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/node": "^25.5.2",
        "@types/supertest": "^7.2.1",
        "supertest": "^7.2.2",
        "typescript": "^6.0.2",
        "vitest": "^4.1.10"
    }
