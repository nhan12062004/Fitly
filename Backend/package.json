        "dotenv": "^17.4.1",
        "express": "^5.2.1",
        "express-rate-limit": "^8.5.2",
        "helmet": "^8.2.0",
        "node-cron": "^4.2.1",
        "node-telegram-bot-api": "^0.67.0",
        "tsx": "^4.21.0",
        "xlsx": "^0.18.5"
    },
    "devDependencies": {
        "@types/axios": "^0.9.36",
        "@types/cors": "^2.8.19",
